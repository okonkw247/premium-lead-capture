# ── Resend Email API ─────────────────────────────────────────
RESEND_API_KEY=your_resend_api_key_here

# The email address your subscribers see in the "From" field
SENDER_EMAIL=adams@adamsxproject.com.ng

# Your personal email — you'll receive lead alerts and daily digest here
NOTIFICATION_EMAIL=your_email_to_receive_alerts@domain.com

# ── Supabase Database ─────────────────────────────────────────
# Get both values from: Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=your_service_role_key_here

# ── Cron Job Protection ───────────────────────────────────────
# Choose any random secret string — used to protect /api/cron/* and /api/admin/* endpoints
CRON_SECRET=choose-any-random-string-here

# ── Whop Product & Webhook ────────────────────────────────────
# Your Whop product page URL (used in launch emails — set before Email 8 sends)
WHOP_PRODUCT_URL=https://whop.com/your-product/
# Secret used to verify Whop webhook signatures (Whop Dashboard → Product → Developer → Webhooks)
WHOP_WEBHOOK_SECRET=your_whop_webhook_secret_here

# ── Paid Product Access (legacy) ─────────────────────────────
PAID_EBOOK_URL=https://whop.com/adams-x-project/

# ── Server (local dev only) ───────────────────────────────────
PORT=8000
