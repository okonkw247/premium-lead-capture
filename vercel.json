{
  "version": 2,
  "builds": [
    { "src": "server.js", "use": "@vercel/node" },
    { "src": "adams-x.jpg", "use": "@vercel/static" },
    { "src": "campaign_image_1.png", "use": "@vercel/static" },
    { "src": "campaign_image_2.png", "use": "@vercel/static" },
    { "src": "index.html", "use": "@vercel/static" },
    { "src": "waitlist.html", "use": "@vercel/static" },
    { "src": "bonus.html", "use": "@vercel/static" },
    { "src": "unsubscribe.html", "use": "@vercel/static" },
    { "src": "favicon.ico", "use": "@vercel/static" },
    { "src": "favicon-32x32.png", "use": "@vercel/static" },
    { "src": "favicon-16x16.png", "use": "@vercel/static" },
    { "src": "apple-touch-icon.png", "use": "@vercel/static" },
    { "src": "ebooks/the-7-day-starter-kit.pdf", "use": "@vercel/static" },
    { "src": "ebooks/monk-mode-starter-kit.pdf", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/server.js" },
    { "src": "/adams-x.jpg", "dest": "/adams-x.jpg" },
    { "src": "/campaign_image_1.png", "dest": "/campaign_image_1.png" },
    { "src": "/campaign_image_2.png", "dest": "/campaign_image_2.png" },
    { "src": "/favicon.ico", "dest": "/favicon.ico" },
    { "src": "/favicon-32x32.png", "dest": "/favicon-32x32.png" },
    { "src": "/favicon-16x16.png", "dest": "/favicon-16x16.png" },
    { "src": "/apple-touch-icon.png", "dest": "/apple-touch-icon.png" },
    {
      "src": "/ebooks/the-7-day-starter-kit.pdf",
      "headers": {
        "Content-Disposition": "attachment; filename=\"The-7-Day-Starter-Kit.pdf\"",
        "Content-Type": "application/pdf"
      },
      "dest": "/ebooks/the-7-day-starter-kit.pdf"
    },
    { "src": "/monk-mode-starter-kit.pdf", "dest": "/ebooks/monk-mode-starter-kit.pdf" },
    { "src": "/waitlist/?", "dest": "/waitlist.html" },
    { "src": "/bonus/?", "dest": "/bonus.html" },
    { "src": "/unsubscribe/?", "dest": "/unsubscribe.html" },
    { "src": "/(.*)", "dest": "/index.html" }
  ],
  "crons": [
    { "path": "/api/cron/digest",            "schedule": "0 8 * * *" },
    { "path": "/api/cron/drip",              "schedule": "0 9 * * *" },
    { "path": "/api/cron/post-purchase-drip","schedule": "0 9 * * *" }
  ]
}
